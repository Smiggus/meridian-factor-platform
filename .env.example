# Copy to .env for local development. Nothing here is a real credential.

# ── API auth ──────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_strong_random_secret
# Token lifetime in minutes (default: 1440 = 24h)
JWT_EXPIRE_MINUTES=1440

# ── Score cache ───────────────────────────────────────────────────────────────
# How long the API serves cached universe scores before re-reading (seconds)
API_SCORE_CACHE_TTL=3600
API_SCORE_CACHE_MAX_ENTRIES=256

# ── PostgreSQL (factor scores live in the `factors` schema) ───────────────────
PGHOST=db.example.internal
PGPORT=5432
PGDB=marketdata
PGUSER=changeme
PGPASS=changeme

# ── Parquet / Iceberg lakehouse (optional; the code degrades to PostgreSQL) ───
MERIDIAN_MINIO_ENDPOINT=object-store.example.internal:9000
MERIDIAN_MINIO_ACCESS_KEY=changeme
MERIDIAN_MINIO_SECRET_KEY=changeme
MERIDIAN_MINIO_USE_SSL=false
MERIDIAN_MINIO_BUCKET=meridian-parquet
# Mirror every committed PostgreSQL score write to the Iceberg warehouse
MERIDIAN_ICEBERG_DUAL_WRITE=true

# ── Alerting ──────────────────────────────────────────────────────────────────
# Push notifications for failed checks and stuck sensors. The test suite points
# this at a black hole and refuses to send under pytest.
MERIDIAN_NTFY_URL=https://ntfy.example.com/meridian
